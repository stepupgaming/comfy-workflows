{
  "irVersion":1,
  "name":"textToImage",
  "nodes":{
    "n1":{
      "type":"CheckpointLoaderSimple",
      "params":{
        "ckpt_name":{
          "$param":"checkpoint"
        }
      },
      "inputs":{}
    },
    "n2":{
      "type":"CLIPTextEncode",
      "params":{
        "text":{
          "$param":"prompt"
        }
      },
      "inputs":{
        "clip":{
          "node":"n1",
          "out":1
        }
      }
    },
    "n3":{
      "type":"CLIPTextEncode",
      "params":{
        "text":{
          "$param":"negative"
        }
      },
      "inputs":{
        "clip":{
          "node":"n1",
          "out":1
        }
      }
    },
    "n4":{
      "type":"EmptyLatentImage",
      "params":{
        "width":{
          "$param":"width"
        },
        "height":{
          "$param":"height"
        },
        "batch_size":1
      },
      "inputs":{}
    },
    "n5":{
      "type":"KSampler",
      "params":{
        "seed":{
          "$param":"seed"
        },
        "steps":20,
        "cfg":8,
        "sampler_name":"euler",
        "scheduler":"normal",
        "denoise":1
      },
      "inputs":{
        "model":{
          "node":"n1",
          "out":0
        },
        "positive":{
          "node":"n2",
          "out":0
        },
        "negative":{
          "node":"n3",
          "out":0
        },
        "latent_image":{
          "node":"n4",
          "out":0
        }
      }
    },
    "n6":{
      "type":"VAEDecode",
      "params":{},
      "inputs":{
        "samples":{
          "node":"n5",
          "out":0
        },
        "vae":{
          "node":"n1",
          "out":2
        }
      }
    },
    "n7":{
      "type":"SaveImage",
      "params":{
        "filename_prefix":"cwf-t2i"
      },
      "inputs":{
        "images":{
          "node":"n6",
          "out":0
        }
      }
    }
  },
  "outputs":[
    {
      "node":"n6",
      "out":0,
      "name":"image"
    }
  ],
  "params":{
    "checkpoint":{
      "name":"checkpoint",
      "type":"combo",
      "description":"Checkpoint file present on the ComfyUI server."
    },
    "seed":{
      "name":"seed",
      "type":"int",
      "description":"Sampling seed."
    },
    "prompt":{
      "name":"prompt",
      "type":"string",
      "description":"Positive prompt."
    },
    "negative":{
      "name":"negative",
      "type":"string",
      "default":"",
      "description":"Negative prompt."
    },
    "width":{
      "name":"width",
      "type":"int",
      "description":"Image width.",
      "default":512
    },
    "height":{
      "name":"height",
      "type":"int",
      "description":"Image height.",
      "default":512
    }
  }
}
