{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stepupgaming.github.io/comfy-workflows/schema/comfy.workflow.schema.json",
  "title": "comfy.workflow.json — Comfy Workflows package manifest",
  "description": "Versioned manifest for a Comfy Workflows npm package. Pure data: inspectable without executing package code.",
  "type": "object",
  "required": ["specVersion", "name", "title", "entry", "parameters", "outputs", "requires"],
  "additionalProperties": false,
  "properties": {
    "specVersion": {
      "description": "Manifest spec version. 1 = legacy string nodePacks; 2 = rich NodePackRequirement objects.",
      "type": "integer",
      "enum": [1, 2]
    },
    "name": {
      "description": "Machine identity, e.g. \"text-to-image\". Unique within its npm package.",
      "type": "string",
      "minLength": 1
    },
    "title": {
      "description": "Human title, e.g. \"Text to Image\".",
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "description": "Package-relative path to the canonical IR document.",
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^([A-Za-z]:[\\\\/]|/)" }
    },
    "description": { "type": "string" },
    "coreVersion": {
      "description": "Minimum core package version (semver range) this package was built against.",
      "type": "string"
    },
    "parameters": {
      "description": "Template parameters, keyed by name. Must cohere with the IR's declared params.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "required"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "description": "Widget kind. \"integer\" is accepted as an alias of \"int\".",
            "type": "string",
            "minLength": 1
          },
          "required": { "type": "boolean" },
          "default": {
            "description": "Default value (JSON scalar). Required params must not need one at run time."
          },
          "options": {
            "type": "array",
            "items": { "type": ["string", "number"] }
          },
          "description": { "type": "string" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": { "description": "Socket type, e.g. IMAGE, LATENT.", "type": "string" }
        }
      }
    },
    "requires": {
      "type": "object",
      "required": ["nodeClasses"],
      "additionalProperties": false,
      "properties": {
        "nodeClasses": {
          "description": "Required Comfy node class names — explicit or derivable from the IR.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "nodePacks": {
          "description": "Installable custom-node packs. specVersion 1: string registry ids. specVersion 2: NodePackRequirement objects. repository is informational — never an automatic git clone.",
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,99}$"
              },
              {
                "type": "object",
                "required": ["id"],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "description": "Canonical Comfy Registry / Manager package id.",
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,99}$"
                  },
                  "name": { "type": "string" },
                  "version": {
                    "description": "Semver range (^1.8.0, >=1.0.0, or exact 1.2.3).",
                    "type": "string"
                  },
                  "repository": {
                    "description": "Informational source URL. Never treated as an automatic clone.",
                    "type": "string"
                  },
                  "provides": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "optional": { "type": "boolean" },
                  "source": { "enum": ["registry", "manual"] }
                }
              }
            ]
          },
          "default": []
        },
        "models": {
          "description": "Model/checkpoint requirements, when known. Informational in v1.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "name"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string" },
              "name": { "type": "string" },
              "optional": { "type": "boolean" }
            }
          },
          "default": []
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minComfyUIVersion": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
