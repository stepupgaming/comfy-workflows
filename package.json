{
  "name": "@stepupgaming/comfy-workflows",
  "version": "0.1.0",
  "description": "Comfy Workflows — code-first, typed, composable workflows for ComfyUI.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nodes": {
      "types": "./dist/nodes/index.d.ts",
      "default": "./dist/nodes/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./ir": {
      "types": "./dist/ir/index.d.ts",
      "default": "./dist/ir/index.js"
    },
    "./wfpack": {
      "types": "./dist/wfpack/index.d.ts",
      "default": "./dist/wfpack/index.js"
    },
    "./schema": "./schema/comfy.workflow.schema.json",
    "./package.json": "./package.json",
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "default": "./dist/recipes/index.js"
    }
  },
  "bin": {
    "comfy-workflows": "./dist/cli/bin.js",
    "cwf": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "sideEffects": false,
  "keywords": [
    "comfyui",
    "comfy-workflows",
    "comfy-workflow",
    "workflows",
    "typescript",
    "code-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stepupgaming/comfy-workflows.git"
  },
  "homepage": "https://stepupgaming.github.io/comfy-workflows/",
  "bugs": {
    "url": "https://github.com/stepupgaming/comfy-workflows/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:packages": "jiti scripts/build-workflow-packages.mjs && pnpm --filter \"./packages/**\" exec tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "codegen:core": "jiti scripts/run-codegen.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "expect-type": "^1.2.1",
    "prettier": "^3.6.2",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}